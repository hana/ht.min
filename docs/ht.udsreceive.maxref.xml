<?xml version='1.0' encoding='utf-8' standalone='yes'?>


<!-- DO NOT EDIT THIS FILE ... YOU WILL LOSE YOUR WORK -->


<c74object name='ht.udsreceive' category='utilities'>

	<digest>Unix Socket Sender </digest>
	<description>Unix Socket Sender </description>


	<!--METADATA-->

	<metadatalist>
		<metadata name='author'>Hananosuke Takimoto </metadata>
		<metadata name='tag'>utilities</metadata>
	</metadatalist>


	<!--ARGUMENTS-->

	<objarglist>

		<objarg name='Destination address' optional='1' type='symbol'>
			<digest>/tmp/thx</digest>
			<description>/tmp/thx.uds.default.sock </description>
		</objarg>

	</objarglist>


	<!--MESSAGES-->

	<methodlist>

		<method name='close'>
			<digest>close current socket </digest>
			<description>close current socket </description>
		</method>

		<method name='bind'>
			<digest>connect to a socket </digest>
			<description>connect to a socket </description>
		</method>

		<method name='bang'>
			<digest>flash received messages </digest>
			<description>flash received messages </description>
		</method>

	</methodlist>


	<!--ATTRIBUTES-->

	<attributelist>

		<attribute name='address' get='1' set='1' type='symbol' size='1' >
			<digest>Message destination</digest>
			<description>Message destination. </description>
		</attribute>

	</attributelist>


	<!--RELATED-->

	<seealsolist>
		<seealso name='udpreceive' />
		<seealso name='ht.udpsend' />
	</seealsolist>


</c74object>
