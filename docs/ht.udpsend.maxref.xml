			<description>1 to open bundle, 0 to close bandle and send </description>
		</method>

		<method name='print'>
			<digest>Output IP addresses of all interface </digest>
			<description>Output IP addresses of all interface </description>
		</method>

		<method name='anything'>
			<digest>send data</digest>
			<description>send data. </description>
		</method>

