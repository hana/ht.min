<c74object name='ht.udssend' category='utilities'>

	<digest>Unix Socket Sender </digest>
	<description>Unix Socket Sender </description>


	<!--METADATA-->

	<metadatalist>
		<metadata name='author'>Hananosuke Takimoto </metadata>
		<metadata name='tag'>utilities</metadata>
	</metadatalist>


	<!--ARGUMENTS-->

	<objarglist>

		<objarg name='send address' optional='1' type='symbol'>
			<digest>/tmp/?? </digest>
			<description>/tmp/?? </description>
		</objarg>

	</objarglist>


	<!--MESSAGES-->

	<methodlist>

		<method name='list'>
			<digest>list to be sent</digest>
			<description>list to be sent. </description>
		</method>

	</methodlist>


	<!--ATTRIBUTES-->

	<attributelist>

		<attribute name='address' get='1' set='1' type='symbol' size='1' >
			<digest>Message destination</digest>
			<description>Message destination. </description>
		</attribute>

	</attributelist>


	<!--RELATED-->

	<seealsolist>
		<seealso name='udpsend' />
	</seealsolist>


</c74object>
